{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "carpooling-admin": {
      "root": "carpooling-admin",
      "framework": "vite"
    },
    "carpooling-driver": {
      "root": "carpooling-driver",
      "framework": "vite"
    },
    "carpooling-passenger": {
      "root": "carpooling-passenger",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin/assets/:match*",
      "destination": {
        "service": "carpooling-admin",
        "path": "/assets/:match*"
      }
    },
    {
      "source": "/admin/:file([^/]+\\.[^/]+)",
      "destination": {
        "service": "carpooling-admin",
        "path": "/:file"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "carpooling-admin",
        "path": "/index.html"
      }
    },
    {
      "source": "/admin/:match*",
      "destination": {
        "service": "carpooling-admin",
        "path": "/index.html"
      }
    },
    {
      "source": "/driver/assets/:match*",
      "destination": {
        "service": "carpooling-driver",
        "path": "/assets/:match*"
      }
    },
    {
      "source": "/driver/:file([^/]+\\.[^/]+)",
      "destination": {
        "service": "carpooling-driver",
        "path": "/:file"
      }
    },
    {
      "source": "/driver",
      "destination": {
        "service": "carpooling-driver",
        "path": "/index.html"
      }
    },
    {
      "source": "/driver/:match*",
      "destination": {
        "service": "carpooling-driver",
        "path": "/index.html"
      }
    },
    {
      "source": "/assets/:match*",
      "destination": {
        "service": "carpooling-passenger",
        "path": "/assets/:match*"
      }
    },
    {
      "source": "/:file([^/]+\\.[^/]+)",
      "destination": {
        "service": "carpooling-passenger",
        "path": "/:file"
      }
    },
    {
      "source": "/:match*",
      "destination": {
        "service": "carpooling-passenger",
        "path": "/index.html"
      }
    }
  ]
}
